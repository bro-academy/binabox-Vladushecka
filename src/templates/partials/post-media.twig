<article class="post">
	{% for item in blog.media.figure %}
		<figure class="post__figure">
			<img class="post__img" src="{{ item.src }}" alt="{{ item.alt }}">
			<figcaption class="post-text">{{ item.figcaption }}</figcaption>
		</figure>
	{% endfor %}
	<h3 class="post__title">{{ blog.media.titel }}</h3>
	<p class="post__text">{{ blog.media.text }}</p>
</article>
