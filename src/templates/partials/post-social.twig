<article class="post">
	<h3 class="post__title">{{ blog.social.titel }}</h3>
	<p class="post__text">{{ blog.social.text }}<a class="post__text-link" href="#">{{ blog.post2.link }}</a>
		{{ blog.post2.text1 }}</p>
	{% for item in blog.social.tags.list %}
		<div class="post__tags">
			<h4 class="post__tags-title">{{ item.titel }}</h4>
			<li class="list-tags">
				<a href="{{ item.link }}">{{ item.text }}</a>
			</li>
		</div>
	{% endfor %}
	{% for item in blog.social.share.list %}
		<div class="post__tags">
			<h4 class="post__tags-title">{{ item.titel }}</h4>
			<li class="list-tags">
				<a href="{{ item.link }}">{{ item.text }}</a>
			</li>
		</div>
	{% endfor %}
</article>
