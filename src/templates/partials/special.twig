<section class="special">
<details class="special__checkboxs">
                    <summary>
                        <h3 class="special__checkboxs__title" >{{ catalog.special.titel }}</h3>
                    </summary>
                    {% for item in catalog.special.list %}
                    <input type="{{ item.type }}" name="{{ item.name }}" value="{{ item.value }}" id="{{ item.id }}"> 
                    <label for="{{ item.for }}">{{ item.name }}</label>
                    {% endfor %}
                </details>
</section> 