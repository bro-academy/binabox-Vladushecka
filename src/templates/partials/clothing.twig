<section class="clothing">
<details class="clothing__checkboxs">
                    <summary>
                        <h3 class="clothing__checkboxs__title" >{{ catalog.clothing.titel }}</h3>
                    </summary>
                    {% for cloth in catalog.clothing.list %}
                    <input type="{{ cloth.type }}" name="{{ cloth.name }}" value="{{ cloth.value }}" id="{{ cloth.id }}"> 
                    <label for="{{ cloth.for }}">{{ cloth.name }}</label>
                    {% endfor %}
                </details>
</section> 
