<section class="contact">
	<h1 class="contact__titel">{{ contact.banner.titel }}</h1>
	<ul class="contact__list">
		{% for item in contact.banner.list %}
			<li class="contact__list-item">
				<a class="contact__list-link" href="{{ item.link }}">{{ item.text }}</a>
			</li>
		{% endfor %}
	</ul>
</section>
